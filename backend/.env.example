# Copy to .env (or export these as real environment variables) — never commit real secrets.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=accessflow
DB_USERNAME=accessflow_user
DB_PASSWORD=changeme

# Generate a long random string for production, e.g.: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_256_BITS
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
LOG_LEVEL=INFO
